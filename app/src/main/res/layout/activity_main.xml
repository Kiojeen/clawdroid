<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:colorBackground"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingTop="20dp"
    android:paddingEnd="16dp"
    android:paddingBottom="16dp"
    tools:context=".MainActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:contentDescription="@string/app_name"
            android:src="@drawable/clawdroid_mark" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:text="@string/app_name"
            android:textColor="?attr/colorPrimary"
            android:textSize="28sp"
            android:textStyle="bold" />

    </LinearLayout>

    <TextView
        android:id="@+id/display"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="12dp"
        android:gravity="end"
        android:maxLines="1"
        android:text="0"
        android:textColor="?attr/colorOnBackground"
        android:textSize="42sp"
        tools:text="128" />

    <GridLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:columnCount="4"
        android:rowCount="5">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/key_clear"
            style="@style/Widget.Claw.Key.Number"
            android:text="@string/clear" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/key_div"
            style="@style/Widget.Claw.Key.Op"
            android:text="÷" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/key_times"
            style="@style/Widget.Claw.Key.Op"
            android:text="×" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/key_minus"
            style="@style/Widget.Claw.Key.Op"
            android:text="−" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/digit_7"
            style="@style/Widget.Claw.Key.Number"
            android:text="7" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/digit_8"
            style="@style/Widget.Claw.Key.Number"
            android:text="8" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/digit_9"
            style="@style/Widget.Claw.Key.Number"
            android:text="9" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/key_plus"
            style="@style/Widget.Claw.Key.Op"
            android:text="+" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/digit_4"
            style="@style/Widget.Claw.Key.Number"
            android:text="4" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/digit_5"
            style="@style/Widget.Claw.Key.Number"
            android:text="5" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/digit_6"
            style="@style/Widget.Claw.Key.Number"
            android:text="6" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/key_eq"
            style="@style/Widget.Claw.Key.Op"
            android:layout_rowSpan="2"
            android:layout_rowWeight="2"
            android:text="=" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/digit_1"
            style="@style/Widget.Claw.Key.Number"
            android:text="1" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/digit_2"
            style="@style/Widget.Claw.Key.Number"
            android:text="2" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/digit_3"
            style="@style/Widget.Claw.Key.Number"
            android:text="3" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/digit_0"
            style="@style/Widget.Claw.Key.Number"
            android:layout_columnSpan="2"
            android:layout_columnWeight="2"
            android:text="0" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/key_dot"
            style="@style/Widget.Claw.Key.Number"
            android:text="." />

    </GridLayout>

</LinearLayout>
