<resources>
    <style name="Theme.{{theme_name}}" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/claw_red</item>
        <item name="colorPrimaryVariant">@color/claw_red_dark</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/claw_ink</item>
        <item name="colorSecondaryVariant">@color/claw_ink</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="android:colorBackground">@color/claw_paper</item>
        <item name="colorOnBackground">@color/claw_ink</item>
        <item name="android:statusBarColor">?attr/colorPrimaryVariant</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <style name="Widget.Claw.Action" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_columnWeight">1</item>
        <item name="android:layout_margin">6dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">?attr/colorOnBackground</item>
        <item name="android:textSize">15sp</item>
        <item name="cornerRadius">20dp</item>
        <item name="strokeColor">?attr/colorPrimary</item>
    </style>
</resources>
